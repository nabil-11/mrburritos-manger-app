import { useState, useEffect, useCallback } from 'react';
import { useHistory } from 'react-router-dom';
import {
  IonContent, IonPage, IonHeader, IonToolbar,
  IonButtons, IonButton, IonIcon, IonRefresher, IonRefresherContent,
  IonSelect, IonSelectOption, IonSpinner, IonToast, IonSearchbar,
} from '@ionic/react';
import { exitOutline, timeOutline, checkmarkCircleOutline, restaurantOutline, bicycleOutline, checkmarkDoneOutline, closeCircleOutline } from 'ionicons/icons';
import { ordersService, authService } from '../common/api';
import { useAuth } from '../auth/AuthContext';
import { Order, ORDER_STATUSES, getStatusLabel } from './types';
import { NEW_ORDER_EVENT } from '../../hooks/useNotifications';

const STATUS_FILTERS = [
  { value: '', label: 'Toutes', icon: null },
  { value: 'pending', label: 'Attente', icon: timeOutline },
  { value: 'confirmed', label: 'Confirmée', icon: checkmarkCircleOutline },
  { value: 'preparing', label: 'Prép.', icon: restaurantOutline },
  { value: 'ready', label: 'Prête', icon: checkmarkDoneOutline },
  { value: 'delivered', label: 'Livrée', icon: bicycleOutline },
  { value: 'cancelled', label: 'Annulée', icon: closeCircleOutline },
];

const STATUS_COLORS: Record<string, string> = {
  pending: '#F59E0B',
  confirmed: '#3B82F6',
  preparing: '#8B5CF6',
  ready: '#10B981',
  delivered: '#6B7280',
  cancelled: '#EF4444',
};

export default function OrdersPage() {
  const history = useHistory();
  const { logout } = useAuth();
  const [orders, setOrders] = useState<Order[]>([]);
  const [loading, setLoading] = useState(true);
  const [activeFilter, setActiveFilter] = useState('pending');
  const [search, setSearch] = useState('');
  const [toast, setToast] = useState<{ open: boolean; message: string; color: string }>({ open: false, message: '', color: 'success' });
  const [updatingId, setUpdatingId] = useState<string | null>(null);

  const fetchOrders = useCallback(async () => {
    try {
      const data = await ordersService.getAll(activeFilter || undefined);
      setOrders(data);
    } catch (err) {
      console.error('Failed to fetch orders:', err);
    } finally {
      setLoading(false);
    }
  }, [activeFilter]);

  useEffect(() => {
    if (!authService.isAuthenticated()) {
      history.push('/login');
      return;
    }
    setLoading(true);
    fetchOrders();
  }, [history, fetchOrders, activeFilter]);

  // Refresh the list and show a toast when a Firebase foreground notification arrives
  useEffect(() => {
    const handleNewOrder = (e: Event) => {
      const { title, body } = (e as CustomEvent).detail ?? {};
      setToast({
        open: true,
        message: body ?? title ?? '🔔 Nouvelle commande reçue !',
        color: 'warning',
      });
      fetchOrders();
    };
    window.addEventListener(NEW_ORDER_EVENT, handleNewOrder);
    return () => window.removeEventListener(NEW_ORDER_EVENT, handleNewOrder);
  }, [fetchOrders]);

  const handleRefresh = async (event: CustomEvent) => {
    await fetchOrders();
    event.detail.complete();
  };

  const handleStatusChange = async (orderId: string, newStatus: string) => {
    const order = orders.find(o => o._id === orderId);
    if (order?.status === newStatus) return;
    setUpdatingId(orderId);
    try {
      await ordersService.updateStatus(orderId, newStatus);
      setToast({ open: true, message: 'Statut mis à jour', color: 'success' });
      await fetchOrders();
    } catch {
      setToast({ open: true, message: 'Erreur de mise à jour', color: 'danger' });
    } finally {
      setUpdatingId(null);
    }
  };

  const handleLogout = async () => {
    await logout();
    history.push('/login');
  };

  const formatDate = (dateStr: string) => {
    return new Date(dateStr).toLocaleDateString('fr-FR', {
      day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit'
    });
  };

  const filtered = orders.filter(o => {
    if (!search.trim()) return true;
    const q = search.toLowerCase();
    return (
      o.orderNumber?.toLowerCase().includes(q) ||
      o.customer.name?.toLowerCase().includes(q) ||
      o.customer.phone?.includes(q)
    );
  });

  const pendingCount = orders.filter(o => o.status === 'pending').length;

  return (
    <IonPage>
      <IonHeader className="ion-no-border">
        <IonToolbar style={{ '--background': '#1A1A1A', '--color': 'white' }}>
          <div className="flex items-center justify-between px-4 py-2">
            <div className="flex items-center gap-2">
              <span style={{ color: '#F5A800', fontWeight: 900, fontSize: 20 }}>MR.</span>
              <span className="text-white font-bold text-lg">Commandes</span>
              {pendingCount > 0 && (
                <span className="bg-red-500 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">
                  {pendingCount}
                </span>
              )}
            </div>
            <IonButtons>
              <IonButton onClick={handleLogout} style={{ '--color': '#9CA3AF' }}>
                <IonIcon slot="icon-only" icon={exitOutline} />
              </IonButton>
            </IonButtons>
          </div>
        </IonToolbar>

        {/* Status filter segment */}
        <div style={{ background: '#1A1A1A', paddingBottom: 8, overflowX: 'auto' }}>
          <div className="flex gap-2 px-4" style={{ minWidth: 'max-content' }}>
            {STATUS_FILTERS.map((f) => (
              <button
                key={f.value}
                onClick={() => setActiveFilter(f.value)}
                className="flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-semibold transition-all whitespace-nowrap"
                style={{
                  background: activeFilter === f.value ? '#F5A800' : '#2D2D2D',
                  color: activeFilter === f.value ? '#000' : '#9CA3AF',
                  border: 'none',
                }}
              >
                {f.icon && <IonIcon icon={f.icon} style={{ fontSize: 12 }} />}
                {f.label}
              </button>
            ))}
          </div>
        </div>
      </IonHeader>

      <IonContent style={{ '--background': '#F3F4F6' }}>
        <IonRefresher slot="fixed" onIonRefresh={handleRefresh}>
          <IonRefresherContent pullingText="Tirez pour actualiser" />
        </IonRefresher>

        {/* Search bar */}
        <div className="px-4 pt-3 pb-1">
          <IonSearchbar
            value={search}
            onIonInput={(e) => setSearch(e.detail.value || '')}
            placeholder="Rechercher commande, client..."
            style={{ '--background': 'white', '--border-radius': '12px', '--box-shadow': 'none', padding: 0 }}
            animated={false}
          />
        </div>

        {loading ? (
          <div className="flex flex-col items-center justify-center py-20 gap-3">
            <IonSpinner name="crescent" style={{ color: '#F5A800', width: 36, height: 36 }} />
            <span className="text-gray-400 text-sm">Chargement...</span>
          </div>
        ) : (
          <div className="px-4 pb-6">
            <div className="flex items-center justify-between mb-3 mt-1">
              <span className="text-gray-500 text-sm font-medium">
                {filtered.length} commande{filtered.length !== 1 ? 's' : ''}
              </span>
            </div>

            {filtered.length === 0 ? (
              <div className="flex flex-col items-center justify-center py-16 gap-2">
                <div style={{ fontSize: 48 }}>📋</div>
                <p className="text-gray-400 font-medium">Aucune commande</p>
                <p className="text-gray-300 text-sm">
                  {activeFilter ? `Aucune commande "${getStatusLabel(activeFilter)}"` : 'Aucune commande trouvée'}
                </p>
              </div>
            ) : (
              <div className="space-y-3">
                {filtered.map((order) => (
                  <div
                    key={order._id}
                    className="bg-white rounded-2xl shadow-sm overflow-hidden"
                    style={{ border: `2px solid ${STATUS_COLORS[order.status] || '#E5E7EB'}22` }}
                  >
                    {/* Status color bar */}
                    <div style={{ height: 4, background: STATUS_COLORS[order.status] || '#E5E7EB' }} />

                    <div className="p-4">
                      {/* Top row */}
                      <div className="flex justify-between items-start mb-3">
                        <div>
                          <div className="flex items-center gap-2 mb-1">
                            <span style={{ color: '#F5A800', fontWeight: 700, fontSize: 13 }}>
                              #{order.orderNumber}
                            </span>
                            <span
                              className="text-xs font-semibold px-2 py-0.5 rounded-full"
                              style={{
                                background: order.type === 'delivery' ? '#ECFDF5' : '#EFF6FF',
                                color: order.type === 'delivery' ? '#059669' : '#2563EB',
                              }}
                            >
                              {order.type === 'delivery' ? '🛵 Livraison' : '🏠 À emporter'}
                            </span>
                          </div>
                          <div className="font-bold text-gray-900 text-base">{order.customer.name}</div>
                          <div className="text-gray-400 text-sm mt-0.5">{order.customer.phone}</div>
                        </div>
                        <div className="text-right">
                          <div style={{ color: '#F5A800', fontWeight: 800, fontSize: 20 }}>
                            {order.total.toFixed(2)}
                          </div>
                          <div className="text-gray-400 text-xs">DT</div>
                        </div>
                      </div>

                      {/* Bottom row */}
                      <div className="flex items-center justify-between pt-3 border-t border-gray-100">
                        <div className="flex items-center gap-2">
                          <div
                            className="w-2 h-2 rounded-full"
                            style={{ background: STATUS_COLORS[order.status] || '#E5E7EB' }}
                          />
                          <span className="text-sm font-medium text-gray-700">
                            {getStatusLabel(order.status)}
                          </span>
                        </div>

                        <div className="flex items-center gap-2">
                          {updatingId === order._id && (
                            <IonSpinner name="dots" style={{ color: '#F5A800', width: 20, height: 20 }} />
                          )}
                          <IonSelect
                            value={order.status}
                            onIonChange={(e) => handleStatusChange(order._id, e.detail.value!)}
                            interface="action-sheet"
                            interfaceOptions={{ header: `Commande #${order.orderNumber}` }}
                            disabled={updatingId === order._id}
                            style={{
                              '--padding-start': '10px',
                              '--padding-end': '10px',
                              '--padding-top': '6px',
                              '--padding-bottom': '6px',
                              background: '#F9FAFB',
                              borderRadius: '10px',
                              fontSize: 13,
                              fontWeight: 600,
                              color: '#374151',
                              minWidth: 130,
                            }}
                          >
                            {ORDER_STATUSES.map((s) => (
                              <IonSelectOption key={s.value} value={s.value}>
                                {s.label}
                              </IonSelectOption>
                            ))}
                          </IonSelect>
                        </div>
                      </div>

                      <div className="text-gray-300 text-xs mt-2">{formatDate(order.createdAt)}</div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        <IonToast
          isOpen={toast.open}
          message={toast.message}
          duration={2000}
          color={toast.color}
          position="top"
          onDidDismiss={() => setToast(t => ({ ...t, open: false }))}
        />
      </IonContent>
    </IonPage>
  );
}
